# ---------------------------------------------------------------------------
# Chemicall — modelo de configuração. Copie para `.env` e preencha.
# O arquivo `.env` NUNCA deve ser versionado nem servido pela web.
# ---------------------------------------------------------------------------

# Ambiente: `production` esconde erros do usuário e ativa HSTS/cookie Secure.
# Use `development` apenas na máquina local.
APP_ENV=production

# URL base pública do sistema, sem barra ao final.
# Usada para montar o link de redefinição de senha — sem ela, o link é montado
# a partir do cabeçalho Host, que pode ser forjado por um atacante.
APP_URL=https://seu-dominio.com/Chemicall

# Tempo de inatividade (em segundos) até a sessão expirar. Padrão: 1800 (30 min).
SESSION_IDLE_TIMEOUT=1800

# --- Banco de Dados --------------------------------------------------------
# Crie um usuário MySQL dedicado com permissão apenas no banco da aplicação.
# Não use `root` em produção.
DB_HOST=localhost
DB_USER=chemicall_app
DB_PASS=sua_senha_aqui
DB_NAME=chemicall

# --- E-mail (SMTP) ---------------------------------------------------------
# Usado apenas pelo "Esqueceu a senha?". Sem estas variáveis o sistema continua
# funcionando: só a redefinição por e-mail fica indisponível, e a troca de senha
# passa a ser feita pelo administrador em Usuários → Editar.
#
# Use uma conta de serviço da instituição, não uma conta pessoal.
SMTP_HOST=smtp.gmail.com
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_senha_de_aplicativo_aqui

# Criptografia: `ssl` (porta 465), `tls` (STARTTLS, porta 587) ou `none`.
# Use `none` apenas em relay interno da instituição, dentro da rede.
SMTP_SECURE=ssl
SMTP_PORT=465

SMTP_FROM_EMAIL=no-reply@seu-dominio.com
SMTP_FROM_NAME="Chemicall - Recuperação de Senha"

# Segundos de espera pelo servidor SMTP antes de desistir. Padrão: 15.
#SMTP_TIMEOUT=15

# Pacote de certificados raiz para validar o TLS do servidor SMTP.
# Deixe comentado: por padrão o sistema usa o `openssl.cafile` do php.ini ou a
# base de certificados do sistema operacional, o que funciona tanto no XAMPP
# quanto em Linux. Preencha só se o envio falhar com erro de certificado.
#   Debian/Ubuntu:  /etc/ssl/certs/ca-certificates.crt
#   RHEL/CentOS:    /etc/pki/tls/certs/ca-bundle.crt
#   XAMPP/Windows:  C:/xampp/apache/bin/curl-ca-bundle.crt
#SMTP_CAFILE=
